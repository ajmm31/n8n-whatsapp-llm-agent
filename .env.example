# Variables de entorno que debe ver n8n (docker-compose, Portainer o .env)
ANTHROPIC_API_KEY=sk-ant-REEMPLAZAR
ANTHROPIC_MODEL=claude-sonnet-5-5
WAHA_URL=http://waha:3000
WAHA_API_KEY=REEMPLAZAR
# Opcional: cambia la personalidad del asistente sin tocar el flujo
# SYSTEM_PROMPT=Eres el asistente de ...
# Necesario en n8n para poder leer $env dentro de los nodos
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
